<IfModule mod_rewrite.c>
    RewriteEngine On

    # Belokkan URL /storage secara aman ke /public/storage
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Arahkan seluruh lalu lintas web utama ke folder public
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Keamanan: Blokir akses langsung ke file .env dan file konfigurasi sensitif
<Files .env>
    Order allow,deny
    Deny from all
</Files>