<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Belokkan URL /storage secara aman ke /public/storage
    RewriteRule ^storage/(.*)$ /public/storage/$1 [L]

    # Jika file/folder BUKAN ada di public/, arahkan ke public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

<Files .env>
    Order allow,deny
    Deny from all
</Files>