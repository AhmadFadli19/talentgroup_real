<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Blokir akses HTTP langsung ke direktori internal storage yang sensitif
    RewriteRule ^storage/(logs|framework|private)/ - [F,L]

    # 2. Arahkan semua request /storage dan /storage-file langsung ke Laravel Front Controller (melewati keterbatasan symlink 403)
    RewriteRule ^(storage|storage-file)(/.*)?$ /public/index.php [L]

    # 3. Sajikan file fisik statis dari public/ jika file-nya ada (misal: CSS, JS, favicon, build)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ /public/$1 [L]

    # 4. Arahkan semua request non-public lainnya ke public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

<FilesMatch "^\.(env|git|env\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>